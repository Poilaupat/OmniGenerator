{
  "fields": [
    {
      "$type": "regex",
      "name": "numlot",
      "pattern": "\\d{9}"
    }
  ],
  "root": {
    "$type": "group",
    "name": "remittance",
    "min-occurs": 1,
    "max-occurs": 5,
    "fields": [
      {
        "$type": "aggregate",
        "name": "total",
        "aggregate-type": "Sum",
        "scope": "Overall",
        "target-element": "cheque",
        "dependent-upon": "amount"
      },
      {
        "$type": "aggregate",
        "name": "count",
        "aggregate-type": "Count",
        "scope": "Overall",
        "target-element": "cheque",
        "dependent-upon": ""
      }
    ],
    "elements": [
      {
        "$type": "document",
        "name": "slip",
        "min-occurs": 1,
        "max-occurs": 1,
        "fields": [
          {
            "$type": "fixed",
            "name": "encline",
            "value": "01"
          },
          {
            "$type": "regex",
            "name": "numremise",
            "pattern": "\\d{7}"
          }
        ]
      },
      {
        "$type": "group",
        "name": "payment",
        "min-occurs": 1,
        "max-occurs": 3,
        "fields": [
          {
            "$type": "list",
            "name": "payor-firstname",
            "list-path": ".\\Resources\\Lists\\first_names.txt"
          },
          {
            "$type": "list",
            "name": "payor-lastname",
            "list-path": ".\\Resources\\Lists\\last_names.txt"
          },
          {
            "$type": "composite",
            "name": "payor-name",
            "dependent-upon": "payor-firstname, payor-lastname",
            "format": "{{payor-firstname}} {{payor-lastname}}"
          },
          {
            "$type": "list",
            "name": "payor-zip-city",
            "list-path": ".\\Resources\\Lists\\zipcodes_cities.txt"
          },
          {
            "$type": "list",
            "name": "payor-lane",
            "list-path": ".\\Resources\\Lists\\addresses.txt"
          },
          {
            "$type": "regex",
            "name": "payor-lane-number",
            "pattern": "\\d{1,3}"
          },
          {
            "$type": "composite",
            "name": "payor-address",
            "dependent-upon": "payor-lane,payor-lane-number",
            "format": " {{payor-lane-number}} {{payor-lane}}"
          },
          {
            "$type": "aggregate",
            "name": "total",
            "aggregate-type": "Sum",
            "scope": "DirectChildren",
            "target-element": "cheque",
            "dependent-upon": "amount"
          },
          {
            "$type": "aggregate",
            "name": "count",
            "aggregate-type": "Count",
            "scope": "DirectChildren",
            "target-element": "cheque",
            "dependent-upon": ""
          }
        ],
        "elements": [
          {
            "$type": "document",
            "name": "coupon",
            "min-occurs": 1,
            "max-occurs": 1,
            "fields": [
              {
                "$type": "fixed",
                "name": "encline",
                "value": "12"
              },
              {
                "$type": "regex",
                "name": "numcoupon",
                "pattern": "\\d{7}"
              }
            ]
          },
          {
            "$type": "document",
            "name": "cheque",
            "min-occurs": 1,
            "max-occurs": 4,
            "fields": [
              {
                "$type": "fixed",
                "name": "encline",
                "value": "03"
              },
              {
                "$type": "amount",
                "name": "amount",
                "min": 10,
                "max": 9999,
                "format": "Euro"
              },
              {
                "$type": "regex",
                "name": "cmc7",
                "pattern": "\\d{7} \\d{9}908 \\d{12}"
              },
              {
                "$type": "key",
                "name": "rlmc",
                "dependent-upon": "cmc7",
                "key-type": "rlmc"
              },
              {
                "$type": "fixed",
                "name": "bank-name",
                "value": "Banque Specimen"
              },
              {
                "$type": "list",
                "name": "bank-zip-city",
                "list-path": ".\\Resources\\Lists\\zipcodes_cities.txt"
              },
              {
                "$type": "list",
                "name": "bank-lane",
                "list-path": ".\\Resources\\Lists\\addresses.txt"
              },
              {
                "$type": "regex",
                "name": "bank-lane-number",
                "pattern": "\\d{1,3}"
              },
              {
                "$type": "composite",
                "name": "bank-address",
                "dependent-upon": "bank-lane,bank-lane-number",
                "format": " {{bank-lane-number}} {{bank-lane}}"
              },
              {
                "$type": "regex",
                "name": "bank-phone",
                "pattern": "0(2|3|4|5) \\d{2} \\d{2} \\d{2} \\d{2}"
              },
              {
                "$type": "fixed",
                "name": "payee-name",
                "value": "Sith Delapille"
              },
              {
                "$type": "list",
                "name": "place",
                "list-path": ".\\Resources\\Lists\\zipcodes_cities.txt"
              },
              {
                "$type": "date",
                "name": "date",
                "day-diff-min": 3,
                "day-diff-max": 400
              }
            ]
          }
        ]
      }
    ]
  }
}