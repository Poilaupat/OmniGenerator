[
  {
    "$type": "list-e",
    "name": "payor-firstname",
    "list-file": ".\\Resources\\Lists\\first_names.txt"
  },
  {
    "$type": "list-e",
    "name": "payor-lastname",
    "list-file": ".\\Resources\\Lists\\last_names.txt"
  },
  {
    "$type": "composite",
    "name": "payor-name",
    "dependent-upon": "payor-firstname, payor-lastname",
    "format": "{{payor-firstname}} {{payor-lastname}}"
  },
  {
    "$type": "list-e",
    "name": "payor-zip-city",
    "list-file": ".\\Resources\\Lists\\zipcodes_cities.txt"
  },
  {
    "$type": "list-e",
    "name": "payor-lane",
    "list-file": ".\\Resources\\Lists\\addresses.txt"
  },
  {
    "$type": "regex",
    "name": "payor-lane-number",
    "pattern": "\\d{1,3}"
  },
  {
    "$type": "composite",
    "name": "payor-address",
    "dependent-upon": "payor-lane,payor-lane-number",
    "format": " {{payor-lane-number}} {{payor-lane}}"
  },
  {
    "$type": "aggregate",
    "name": "total",
    "aggregate-type": "Sum",
    "scope": "DirectChildren",
    "target-element": "cheque",
    "dependent-upon": "amount"
  },
  {
    "$type": "aggregate",
    "name": "count",
    "aggregate-type": "Count",
    "scope": "DirectChildren",
    "target-element": "cheque",
    "dependent-upon": ""
  }
]