{
  "packager": "packager.omni.sql",
  "root": {
    "fields": [
      {
        "$type": "constant",
        "name": "truncate-before-insert",
        "value":  "true"
      }
    ],
    "group": {
      "$type": "group",
      "name": "script",
      "min-occurs": 1,
      "max-occurs": 1,
      "fields": [],
      "elements": [
        {
          "$type": "document",
          "name": "T_CONF_ELIGIBILITY_CONSECUTIVE_CHECKS",
          "min-occurs": 1,
          "max-occurs": 1,
          "fields": [
            {
              "$type": "equiprobable-list",
              "name": "bankCode",
              "list-file": ".\\Resources\\Lists\\codes_banques.txt"
            },
            {
              "$type": "equiprobable-list",
              "name": "providerSourceId",
              "list-file": ".\\Resources\\Lists\\codes_banques.txt"
            },
            {
              "$type": "date",
              "name": "date-created",
              "day-diff-min": 1,
              "day-diff-max": 365
            },
            {
              "$type": "regex",
              "name": "account",
              "pattern": "\\d{11}"
            },
            {
              "$type": "regex",
              "name": "z4",
              "pattern": "\\d{7}"
            },
            {
              "$type": "regex",
              "name": "z3",
              "pattern": "\\d{9}908"
            },
            {
              "$type": "composite",
              "name": "z2",
              "dependent-upon": "account",
              "format": "0{{account}}"
            },
            {
              "$type": "constant",
              "name": "isTechnicalAccount",
              "value": "0"
            }
          ]
        }
      ]
    }
  }
}