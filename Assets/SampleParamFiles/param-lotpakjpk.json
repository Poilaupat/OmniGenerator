{
  "$schema": "../omnigenerator-schema.json",
  "packager": "packager.omni.imageonly",
  "hierarchy": {
    "fields": [
      {
        "$type": "constant",
        "name": "organization-code",
        "value": "16038"
      },
      {
        "$type": "constant",
        "name": "organization-unit-code",
        "value": "16001"
      },
      {
        "$type": "constant",
        "name": "capture-point-code",
        "value": "16001"
      },
      {
        "$type": "constant",
        "name": "scanner-code",
        "value": "001"
      },
      {
        "$type": "constant",
        "name": "scanner-serial-number",
        "value": "123456789"
      },
      {
        "$type": "increment",
        "name": "packet-number",
        "start": 1,
        "increment": 1
      },
      {
        "$type": "date",
        "name": "packet-date",
        "day-diff-min": -2,
        "day-diff-max": 0
      },
      {
        "$type": "composite",
        "name": "packet-name",
        "dependent-upon": "packet-date,organization-code,organization-unit-code,scanner-code,scanner-serial-number,packet-number",
        "format": "{{packet-date | format:\"yyMMddHHmmss\"}}{{organization-code}}{{organization-unit-code}}{{scanner-code}}{{scanner-serial-number}}{{packet-number | pad_left:4,'0' }}"
      }
    ],
    "root": {
      "$type": "group",
      "name": "batch",
      "min-occurs": 1,
      "max-occurs": 1,
      "fields": [],
      "elements": [
        {
          "$type": "document",
          "name": "batch-ticket",
          "renderer": "renderer.omni.batch-ticket",
          "min-occurs": 1,
          "max-occurs": 1,
          "field-configuration-file": "DocsAndGroups/fields-batch-ticket.json"
        },
        {
          "$type": "group",
          "name": "remittance",
          "min-occurs": 2,
          "max-occurs": 2,
          "fields": [
            {
              "$type": "aggregate",
              "name": "total-amount",
              "aggregate-type": "Sum",
              "scope": "DirectChildren",
              "target-element": "cheque",
              "dependent-upon": "amount"

            },
            {
              "$type": "aggregate",
              "name": "total-cheque",
              "aggregate-type": "Count",
              "scope": "DirectChildren",
              "target-element": "cheque",
              "dependent-upon": ""

            }
          ],
          "elements": [
            {
              "$type": "document",
              "renderer": "renderer.omni.deposit-slip",
              "name": "slip",
              "min-occurs": 1,
              "max-occurs": 1,
              "field-configuration-file": "DocsAndGroups\\fields-deposit-slip.json",
              "fields": []
            },
            {
              "$type": "document",
              "renderer": "renderer.omni.cheque",
              "name": "cheque",
              "min-occurs": 25,
              "max-occurs": 25,
              "field-configuration-file": "DocsAndGroups\\fields-cheque.json",
              "fields": []
            }
          ]
        }
      ]
    }
  }
}