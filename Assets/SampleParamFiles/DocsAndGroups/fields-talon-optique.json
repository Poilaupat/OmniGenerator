[
  {
    "$type": "constant",
    "name": "encline",
    "value": "12"
  },
  {
    "$type": "numeric",
    "name": "amount",
    "min": 100,
    "max": 99999
  },
  {
    "$type": "constant",
    "name": "code-centre",
    "value": "06"
  },
  {
    "$type": "constant",
    "name": "code-nature",
    "value": "8"
  },
  {
    "$type": "composite",
    "name": "group1-payload",
    "dependent-upon": "code-nature, code-centre, amount",
    "format": "{{code-nature}}{{code-centre}} {{amount:00000000}}"
  },
  {
    "$type": "key",
    "name": "group1-key",
    "dependent-upon": "group1-payload",
    "key-type": "tip"
  },
  {
    "$type": "composite",
    "name": "group1",
    "dependent-upon": "group1-payload, group1-key",
    "format": "{{group1-key}}{{group1-payload}}"
  },
  {
    "$type": "constant",
    "name": "document-type",
    "value": "9"
  },
  {
    "$type": "regex",
    "name": "code-application",
    "pattern": "(2|3|4|5|6)"
  },
  {
    "$type": "regex",
    "name": "codique",
    "pattern": "\\d{6}"
  },
  {
    "$type": "regex",
    "name": "reference-operation",
    "pattern": "\\d{17}"
  },
  {
    "$type": "composite",
    "name": "group2-payload",
    "dependent-upon": "document-type, code-application, codique, reference-operation",
    "format": "{{reference-operation}}{{codique}}{{code-application}}{{document-type}}"
  },
  {
    "$type": "key",
    "name": "group2-key",
    "dependent-upon": "group2-payload",
    "key-type": "tip"
  },
  {
    "$type": "composite",
    "name": "group2",
    "dependent-upon": "group2-payload, group2-key",
    "format": "{{group2-key}}{{group2-payload}}"
  },
  {
    "$type": "constant",
    "name": "code-etablissement",
    "value": "0001"
  },
  {
    "$type": "regex",
    "name": "code-emetteur",
    "pattern": "(920033|930033|930044|940033|940044|950033|960033)"
  },
  {
    "$type": "composite",
    "name": "group3-payload",
    "dependent-upon": "code-etablissement, code-emetteur",
    "format": "{{code-emetteur}}{{code-etablissement}}"
  },
  {
    "$type": "key",
    "name": "group3-key",
    "dependent-upon": "group3-payload",
    "key-type": "tip"
  },
  {
    "$type": "composite",
    "name": "group3",
    "dependent-upon": "group3-payload, group3-key",
    "format": "{{group3-payload}}{{group3-key}} "
  }
]