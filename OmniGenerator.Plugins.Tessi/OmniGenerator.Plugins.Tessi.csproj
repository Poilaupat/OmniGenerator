<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnableDynamicLoading>true</EnableDynamicLoading>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="OmniGenerator.Plugins.Tessi.Test" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OmniGenerator.Lib\OmniGenerator.Lib.csproj">
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Update="Nerdbank.GitVersioning" Version="3.9.50" />
		<PackageReference Include="Roslynator.Analyzers" Version="4.14.1" PrivateAssets="all" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="call $(ProjectDir)Scripts\DeployPlugins.bat $(ProjectName) $(SolutionDir) $(OutDir)" />
	</Target>

</Project>
