{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs\\Errors.txt",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ]
  },
  "general-settings": {
    "progress-resolution": 5
  }
}
