{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "..\\Logs\\OmniGeneratorCli.log"
        }
      }
    ]
  },
  "AppSettings": {
    "progress-resolution": 100
  }
}
